{
  "info": {
    "name": "Nutrition API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Food Database",
      "item": [
        {
          "name": "Get All Foods",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods"]
            }
          }
        },
        {
          "name": "Search Foods",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods/search?query=chicken",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "chicken"
                }
              ]
            }
          }
        },
        {
          "name": "Add Food",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quinoa\",\n  \"calories\": 120,\n  \"protein\": 4.5,\n  \"carbs\": 21.3,\n  \"fat\": 1.9,\n  \"servingSize\": \"100g\"\n}"
            }
          }
        },
        {
          "name": "Update Food",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods/11",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods", "11"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quinoa\",\n  \"calories\": 125,\n  \"protein\": 4.8,\n  \"carbs\": 22.0,\n  \"fat\": 2.0,\n  \"servingSize\": \"100g\"\n}"
            }
          }
        },
        {
          "name": "Delete Food",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods/11",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods", "11"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/health",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Nutrition Tracking",
      "item": [
        {
          "name": "Get Weekly Nutrition",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/weekly?weekStartDate={{weekStartDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "weekly"],
              "query": [
                {
                  "key": "weekStartDate",
                  "value": "{{weekStartDate}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Daily Nutrition",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nutrition/day/0?weekStartDate={{weekStartDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "day", "0"],
              "query": [
                {
                  "key": "weekStartDate",
                  "value": "{{weekStartDate}}"
                }
              ]
            }
          }
        },
        {
          "name": "Add Food to Day",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/nutrition/day/0/foods?weekStartDate={{weekStartDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "day", "0", "foods"],
              "query": [
                {
                  "key": "weekStartDate",
                  "value": "{{weekStartDate}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salmon\",\n  \"calories\": 208,\n  \"protein\": 20,\n  \"carbs\": 0,\n  \"fat\": 13,\n  \"servingSize\": \"100g\"\n}"
            }
          }
        },
        {
          "name": "Update Food in Day",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/nutrition/day/1/foods/{{foodId}}?weekStartDate={{weekStartDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "day", "1", "foods", "{{foodId}}"],
              "query": [
                {
                  "key": "weekStartDate",
                  "value": "{{weekStartDate}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salmon\",\n  \"calories\": 250,\n  \"protein\": 25,\n  \"carbs\": 0,\n  \"fat\": 15,\n  \"servingSize\": \"120g\"\n}"
            }
          }
        },
        {
          "name": "Delete Food from Day",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/nutrition/day/0/foods/{{foodId}}?weekStartDate={{weekStartDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "day", "0", "foods", "{{foodId}}"],
              "query": [
                {
                  "key": "weekStartDate",
                  "value": "{{weekStartDate}}"
                }
              ]
            }
          }
        },
        {
          "name": "Move Food Between Days",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/nutrition/move-food?weekStartDate={{weekStartDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "move-food"],
              "query": [
                {
                  "key": "weekStartDate",
                  "value": "{{weekStartDate}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceDayIndex\": 0,\n  \"targetDayIndex\": 2,\n  \"foodItemId\": \"{{foodId}}\"\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "weekStartDate",
      "value": "2025-02-16",
      "type": "string"
    },
    {
      "key": "foodId",
      "value": "67e58f8e2c88b4661ff73a44",
      "type": "string"
    }
  ]
}
